{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W7-2B candidate documents (not approved or frozen)",
  "$defs": {
    "case": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[SIDEM][0-9]{2}$"
        },
        "category": {
          "enum": [
            "simple",
            "independent",
            "dependent",
            "external_evidence",
            "memory"
          ]
        },
        "fixture_version": {
          "const": "w7-2b-v1-candidate"
        },
        "approval_status": {
          "const": "CANDIDATE_PENDING_HUMAN_APPROVAL"
        },
        "original_design": {
          "type": "object",
          "properties": {
            "report_section": {
              "const": "4"
            },
            "table_columns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 5,
              "maxItems": 5
            },
            "original_input": {
              "type": "string",
              "minLength": 1
            },
            "original_description": {
              "type": "string"
            },
            "original_question": {
              "type": "string",
              "minLength": 1
            },
            "original_expected_request_spec": {
              "type": "string",
              "minLength": 1
            },
            "original_expected_contract": {
              "type": "string",
              "minLength": 1
            },
            "original_completion_condition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "report_section",
            "table_columns",
            "original_input",
            "original_description",
            "original_question",
            "original_expected_request_spec",
            "original_expected_contract",
            "original_completion_condition"
