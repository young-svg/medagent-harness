          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "offset_convention": {
          "type": "string",
          "minLength": 1
        },
        "expected_request_spec": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^RQ[1-9][0-9]*$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "source_span": {
                    "type": "string",
                    "minLength": 1
                  },
                  "semantic_type": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "text",
                  "required",
                  "order",
                  "source_span",
                  "semantic_type"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "source_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "request_item_id": {
                "type": "string",
                "pattern": "^RQ[1-9][0-9]*$"
              },
              "field": {
                "const": "question"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "original_question_span": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "text",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "source_context_spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "text",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "request_item_id",
              "field",
              "text",
              "start",
              "end",
              "original_question_span",
              "source_context_spans"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "expected_answer_contract": {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "requested_deliverables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "response_mode": {
              "type": "string",
              "minLength": 1
            },
            "must_cover": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "optional_cover": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "breadth": {
              "type": "string",
              "minLength": 1
            },
            "coverage_checklist": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "enum": [
                      "MUST",
                      "OPTIONAL"
                    ]
                  },
                  "covered": {
                    "const": false
                  }
                },
                "required": [
                  "item",
                  "priority",
                  "covered"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "intent",
            "requested_deliverables",
            "response_mode",
            "must_cover",
            "optional_cover",
            "avoid",
            "breadth",
            "coverage_checklist"
          ],
          "additionalProperties": false
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "restriction_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "text",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "must_request_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^RQ[1-9][0-9]*$"
          },
          "minItems": 1
        },
        "optional_request_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^RQ[1-9][0-9]*$"
          },
          "minItems": 0
        },
        "expected_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^RQ[1-9][0-9]*$"
              },
              "to": {
                "type": "string",
                "pattern": "^RQ[1-9][0-9]*$"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "dependency_policy": {
          "type": "string",
          "minLength": 1
        },
        "external_evidence_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "request_item_id": {
                "type": "string",
                "pattern": "^RQ[1-9][0-9]*$"
              },
              "source_category": {
                "enum": [
                  "guideline",
                  "research",
                  "classification",
                  "external"
                ]
              },
              "acceptable_source_categories": {
                "type": "array",
                "items": {
                  "enum": [
                    "guideline",
                    "research",
                    "classification",
                    "external"
                  ]
                },
                "minItems": 1
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "execution": {
                "enum": [
                  "retrieve",
                  "reuse_only"
                ]
              },
              "upstream_request_item_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^RQ[1-9][0-9]*$"
                },
                "minItems": 0
              },
              "requires_admission_delivery_citation": {
                "const": true
              }
            },
            "required": [
              "request_item_id",
              "source_category",
              "acceptable_source_categories",
              "topic",
              "required",
              "execution",
              "upstream_request_item_ids",
              "requires_admission_delivery_citation"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "session_layout": {
          "type": "object",
          "properties": {
            "active_session": {
              "const": "A"
            },
            "sessions": {
              "type": "object",
              "required": [
                "A"
              ],
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "user"
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "role",
                    "content"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "isolate_per_case_and_group": {
              "const": true
            },
            "seed_mode": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "active_session",
            "sessions",
            "isolate_per_case_and_group",
            "seed_mode"
          ],
          "additionalProperties": false
        },
        "history_dependency": {
          "enum": [
            "none",
            "required",
            "current_sufficient_overrides_history"
          ]
        },
        "completion_rubric": {
          "type": "object",
          "properties": {
            "PASS": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "PARTIAL": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "FAIL": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "per_item": {
              "type": "object",
              "properties": {
                "satisfied": {
                  "const": 1
                },
                "partial": {
                  "const": 0.5
                },
                "unanswered": {
                  "const": 0
                },
                "off_topic": {
                  "const": 0
                },
                "insufficient_information": {
                  "type": "null"
                },
                "uncertain": {
                  "type": "null"
                },
                "execution_error": {
                  "const": 0
                }
              },
              "required": [
                "satisfied",
                "partial",
                "unanswered",
                "off_topic",
                "insufficient_information",
                "uncertain",
                "execution_error"
              ],
              "additionalProperties": false
            },
            "aggregation": {
              "type": "string",
              "minLength": 1
            },
            "optional_scored_separately": {
              "const": true
            },
            "w2_is_not_independent_ground_truth": {
              "const": true
            },
            "human_scoring": {
              "type": "string",
              "minLength": 1
            },
            "item_specific_criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "request_item_id": {
                    "type": "string",
                    "pattern": "^RQ[1-9][0-9]*$"
                  },
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_completion_condition": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "request_item_id",
                  "criterion",
                  "source_completion_condition"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "memory_off": {
              "type": "object",
              "properties": {
                "task_grade": {
                  "type": "string",
                  "minLength": 1
                },
                "safe_behavior": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "task_grade",
                "safe_behavior"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "PASS",
            "PARTIAL",
            "FAIL",
            "per_item",
            "aggregation",
            "optional_scored_separately",
            "w2_is_not_independent_ground_truth",
            "human_scoring",
            "item_specific_criteria"
          ],
          "additionalProperties": false
        },
        "forbidden_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "human_review_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "required_tool_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "case_id",
        "category",
        "fixture_version",
        "approval_status",
        "original_design",
        "description",
        "question",
        "offset_convention",
        "expected_request_spec",
        "source_mappings",
        "expected_answer_contract",
        "restrictions",
        "restriction_mappings",
        "must_request_item_ids",
        "optional_request_item_ids",
        "expected_dependencies",
        "dependency_policy",
        "external_evidence_requirements",
        "session_layout",
        "history_dependency",
        "completion_rubric",
        "forbidden_claims",
        "human_review_required",
        "required_tool_policy"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "null"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "admitted": {
          "const": false
        },
        "admission_reason": {
          "const": "not_evaluated"
        },
        "collection": {
          "enum": [
            "clinical_knowledge",
            "clinical_guidelines"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "properties": {
            "source_kind": {
              "enum": [
                "guideline",
                "research",
                "classification",
                "external"
              ]
            },
            "synthetic": {
              "const": true
            },
            "fixture_version": {
              "const": "w7-2b-v1-candidate"
            },
            "fixture_date": {
              "type": "string",
              "minLength": 1
            },
            "real_world_currentness": {
              "const": "NOT_ASSERTED"
            }
          },
          "required": [
            "source_kind",
            "synthetic",
            "fixture_version",
            "fixture_date",
            "real_world_currentness"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "source_id",
        "title",
        "section",
        "source",
        "url",
        "text",
        "score",
        "rank",
        "admitted",
        "admission_reason",
        "collection",
        "topic",
        "metadata"
      ],
      "additionalProperties": false
    },
    "cases_document": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "fixture_version": {
          "const": "w7-2b-v1-candidate"
        },
        "approval_status": {
          "const": "CANDIDATE_PENDING_HUMAN_APPROVAL"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          },
          "minItems": 24,
          "maxItems": 24
        }
      },
      "required": [
        "schema_version",
        "fixture_version",
        "approval_status",
        "cases"
      ],
      "additionalProperties": false
    },
    "corpus_document": {
      "type": "object",
      "properties": {
        "fixture_version": {
          "const": "w7-2b-v1-candidate"
        },
        "approval_status": {
          "const": "CANDIDATE_PENDING_HUMAN_APPROVAL"
        },
        "synthetic_only": {
          "const": true
        },
        "admission_threshold": {
          "const": 0.63
        },
        "top_k": {
          "const": 5
        },
        "source_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "request_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[SIDEM][0-9]{2}$"
              },
              "request_item_id": {
                "type": "string",
                "pattern": "^RQ[1-9][0-9]*$"
              },
              "execution": {
                "enum": [
                  "retrieve",
                  "reuse_only"
                ]
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "source_category": {
                "enum": [
                  "guideline",
                  "research",
                  "classification",
                  "external"
                ]
              },
              "acceptable_source_categories": {
                "type": "array",
                "items": {
                  "enum": [
                    "guideline",
                    "research",
                    "classification",
                    "external"
                  ]
                },
                "minItems": 1
