              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "case_id",
              "request_item_id",
              "execution",
              "topic",
              "source_category",
              "acceptable_source_categories",
              "success_source_ids",
              "success_source_ids_semantics",
              "tools"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "retrieval_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[SIDEM][0-9]{2}$"
              },
              "request_item_id": {
                "type": "string",
                "pattern": "^RQ[1-9][0-9]*$"
              },
              "variant": {
                "enum": [
                  "success",
                  "no_results",
                  "low_score",
                  "wrong_category"
                ]
              },
              "records": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/source"
                },
                "minItems": 0
              },
              "applicable": {
                "type": "boolean"
              },
              "selection_required_before_return": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "expected_evidence_gate": {
                "enum": [
                  "eligible_not_sufficient",
                  "not_satisfied",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "case_id",
              "request_item_id",
              "variant",
              "records",
              "applicable",
              "selection_required_before_return",
              "expected_evidence_gate"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "query_rules": {
          "type": "object",
          "properties": {
            "version": {
              "const": "w7-query-selection-v1.1-candidate"
            },
            "normalization": {
              "const": "NFKC_casefold_collapse_whitespace"
            },
            "matching": {
              "const": "all_concept_groups_any_alias"
            },
            "latin_match": {
              "const": "whole_words_or_phrases"
            },
            "han_match": {
              "const": "substring"
            },
            "multiple_topics": {
              "const": "reject_ambiguous"
            },
            "rq_only_fallback": {
              "const": false
            },
            "topic_concept_groups": {
              "type": "object",
              "properties": {
                "cough": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "minItems": 1
                },
                "exercise_sleep": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "minItems": 2
                },
                "hydration_headache": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "minItems": 2
                }
              },
              "required": [
                "cough",
                "exercise_sleep",
                "hydration_headache"
              ],
              "additionalProperties": false
            },
            "tool_collections": {
              "type": "object",
              "properties": {
                "search_knowledge": {
                  "const": "clinical_knowledge"
                },
                "clinical_guideline": {
                  "const": "clinical_guidelines"
                },
                "disease_code": {
                  "const": "clinical_guidelines"
                }
